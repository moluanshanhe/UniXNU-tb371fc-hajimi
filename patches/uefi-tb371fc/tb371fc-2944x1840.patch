+      (FB_HEIGHT != 1840) || (FixedPcdGet8 (PcdFrameBufferColorDepth) != 32)) {
     return EFI_UNSUPPORTED;
   }
   ImageBytes = (UINT64)FB_WIDTH * FB_HEIGHT * FB_BPP;
