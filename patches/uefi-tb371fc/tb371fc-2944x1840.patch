diff --git a/Platforms/Lenovo/j716fPkg/Library/J716fFrameBufferSerialPortLib/FrameBufferSerialPortLib.c b/Platforms/Lenovo/j716fPkg/Library/J716fFrameBufferSerialPortLib/FrameBufferSerialPortLib.c
